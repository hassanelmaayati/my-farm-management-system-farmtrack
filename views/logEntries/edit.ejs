<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Edit Log Entry</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/navbar.ejs') %>
  <%- include('../partials/breadcrumbs.ejs', { crumbs: [
  { label: 'My Structures', url: '/structures' },
  { label: structure.name, url: `/structures/${structure._id}` },
  { label: animal.name, url: `/structures/${structure._id}/animals/${animal._id}` },
  { label: 'Edit Log Entry', url: null }
]}) %>

  <div class="container">
    <h1>Edit Log Entry</h1>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <form class="form" action="/structures/<%= structure._id %>/animals/<%= animal._id %>/logEntries/<%= logEntry._id %>?_method=PUT" method="POST">
      <div class="form-group">
        <label for="date">Date</label>
        <input type="date" name="date" id="date" value="<%= logEntry.date ? logEntry.date.toISOString().split('T')[0] : '' %>" required>
      </div>

      <div class="form-group">
        <label for="eventType">Event Type</label>
        <select name="eventType" id="eventType" required>
          <% const types = ['Fed', 'Vet Visit', 'Sold', 'Died', 'Other']; %>
          <% types.forEach(t => { %>
            <option value="<%= t %>" <%= logEntry.eventType === t ? 'selected' : '' %>><%= t %></option>
          <% }) %>
        </select>
      </div>

      <div class="form-group">
        <label for="description">Description</label>
        <textarea name="description" id="description"><%= logEntry.description %></textarea>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Update Entry</button>
        <a href="/structures/<%= structure._id %>/animals/<%= animal._id %>" class="btn">Cancel</a>
      </div>
    </form>
  </div>
</body>
</html>
