<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Edit <%= structure.name %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/navbar.ejs') %>

  <div class="container">
    <h1>Edit <%= structure.name %></h1>

    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <form class="form" action="/structures/<%= structure._id %>?_method=PUT" method="POST">
      <div class="form-group">
        <label for="name">Name</label>
        <input type="text" name="name" id="name" value="<%= structure.name %>" required>
      </div>

      <div class="form-group">
        <label for="type">Type</label>
        <select name="type" id="type" required>
          <% const types = ['Barn', 'Stable', 'Coop', 'Pen', 'Other']; %>
          <% types.forEach(t => { %>
            <option value="<%= t %>" <%= structure.type === t ? 'selected' : '' %>><%= t %></option>
          <% }) %>
        </select>
      </div>

      <div class="form-group">
        <label for="notes">Notes</label>
        <textarea name="notes" id="notes"><%= structure.notes %></textarea>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Update Structure</button>
        <a href="/structures/<%= structure._id %>" class="btn">Cancel</a>
      </div>
    </form>
  </div>
</body>
</html>
